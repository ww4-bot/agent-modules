{ config, lib, pkgs, ... }:

let
  cfg = config.services.claudeAgent;

  bashList = name: xs:
    "${name}=(\n" + lib.concatMapStrings (x: "  ${lib.escapeShellArg x}\n") xs + ")\n";

  # The ONLY templated part of the guard. Everything below it is verbatim logic
  # covered by the adversarial matrix.
  profileBlock = ''
    # ─── GENERATED PROFILE (from services.claudeAgent) ───────────────────────
    AGENT_USER=${lib.escapeShellArg cfg.user}
    OPERATOR=${lib.escapeShellArg cfg.operator}
    WORKSPACE=${lib.escapeShellArg cfg.workspace}
    PROTECTED_BRANCH=${lib.escapeShellArg cfg.protectedBranch}
    ${bashList "PROTECTED_PATHS" cfg.protectedPaths}
    ${bashList "WRITABLE_PATHS" cfg.writablePaths}
    ${bashList "APPLY_COMMANDS" cfg.deniedApplyCommands}
    # ─── END GENERATED PROFILE ───────────────────────────────────────────────
  '';

  # PATH is pinned rather than inherited: the guard is a security backstop, and
  # a backstop that silently fails because `jq` is missing from some caller's
  # environment is not a backstop. (On the Ubuntu port this is an apt dependency
  # and a genuine failure mode.) gawk specifically — mawk's regex differs and the
  # heredoc stripper relies on GNU behaviour.
  guardPath = lib.makeBinPath [ pkgs.jq pkgs.gawk pkgs.gnused pkgs.gnugrep pkgs.coreutils ];

  guardScript = pkgs.writeTextFile {
    name = "pretooluse-guard.sh";
    executable = true;
    text = ''
      #!${pkgs.runtimeShell}
      set -uo pipefail
      export PATH=${guardPath}''${PATH:+:$PATH}
      ${profileBlock}
      ${builtins.readFile ./guard-logic.sh}
    '';
  };

  reflectionHook = pkgs.writeTextFile {
    name = "reflection-hook.sh";
    executable = true;
    text = ''
      #!${pkgs.runtimeShell}
      set -euo pipefail
      export PATH=${guardPath}''${PATH:+:$PATH}
      AGENT_USER=${lib.escapeShellArg cfg.user}
      OPERATOR=${lib.escapeShellArg cfg.operator}
      SESSION_N=${toString cfg.reflection.sessionInterval}
      OPEN_CAP=${toString cfg.reflection.openItemCap}
      ${builtins.readFile ./reflection-logic.sh}
    '';
  };

  clockHook = pkgs.writeTextFile {
    name = "clock-hook.sh";
    executable = true;
    text = ''
      #!${pkgs.runtimeShell}
      # Host-global settings mean this runs for every session on the box; only
      # the agent wants a clock line prepended to every prompt it receives.
      [ "$(${pkgs.coreutils}/bin/id -un 2>/dev/null)" = ${lib.escapeShellArg cfg.user} ] || exit 0
      # No jq: this fires on EVERY prompt, so it stays one printf (~4ms) and
      # cannot block input.
      printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"[clock] %s"}}' \
        "$(${pkgs.coreutils}/bin/date '+%Y-%m-%d %H:%M:%S %Z %A (UTC%:z, epoch %s)')"
    '';
  };

  managedSettings = {
    _comment =
      "ROOT-OWNED, TAMPER-PROOF Claude Code policy, generated by services.claudeAgent. "
      + "Safety does NOT come from this allow list. It comes from (1) the OS: the agent is an "
      + "unprivileged user whose only privileged path is an explicit sudo allowlist; (2) this deny "
      + "list plus the root-owned PreToolUse guard; (3) the change gate — comin applies only what "
      + "reached main. Given those, `allow` is intentionally broad so the agent can work without a "
      + "prompt on every read. Tighten by adding to `deny`/the guard, NOT by narrowing `allow`.";
    _comment_hostglobal =
      "MANAGED SETTINGS ARE HOST-GLOBAL — this applies to every Claude Code session on the box, "
      + "including the operator's own. All three hooks therefore begin with an agent-scope guard and "
      + "no-op for other users. Keep that guard in any hook added here. The permission rules DO apply "
      + "to everyone by design; confirm the operator can live with the deny list before deploying to a "
      + "host they work on.";
    allowManagedPermissionRulesOnly = true;
    allowManagedHooksOnly = true;
    permissions = {
      disableBypassPermissionsMode = "disable";
      allow = [ "Read" "Grep" "Glob" "Edit" "Write" "WebSearch" "WebFetch" "Bash(*)" ];
      deny = [
        "Bash(sudo rm:*)" "Bash(shred:*)" "Bash(truncate:*)" "Bash(dd:*)"
        "Bash(mkfs:*)" "Bash(wipefs:*)" "Bash(fdisk:*)" "Bash(parted:*)"
        "Bash(git push:* --force:*)"
        "Bash(git push:* ${cfg.protectedBranch}:*)"
        "Bash(git push:* :${cfg.protectedBranch}:*)"
        "Bash(:* /dev/sd:*)"
      ]
      ++ lib.concatMap (c: [ "Bash(${c}:*)" "Bash(sudo ${c}:*)" ]) cfg.deniedApplyCommands
      ++ cfg.extraDeny;
    };
    hooks = {
      PreToolUse = [{
        matcher = "Bash";
        hooks = [{ type = "command"; command = "${cfg.etcDir}/pretooluse-guard.sh"; }];
      }];
    }
    // lib.optionalAttrs cfg.reflection.enable {
      Stop = [{ hooks = [{ type = "command"; command = "${cfg.etcDir}/reflection-hook.sh"; }]; }];
    }
    // lib.optionalAttrs cfg.clock.enable {
      UserPromptSubmit = [{ hooks = [{ type = "command"; command = "${cfg.etcDir}/clock-hook.sh"; timeout = 5; }]; }];
    };
  };

in
{
  options.services.claudeAgent = {
    enable = lib.mkEnableOption "the scoped Claude Code agent harness";

    user = lib.mkOption {
      type = lib.types.str; default = "claude";
      description = "Unprivileged account the agent runs as. Hooks no-op for anyone else.";
    };
    operator = lib.mkOption {
      type = lib.types.str; default = "the operator";
      description = "Name used in denial messages; should read naturally mid-sentence.";
    };
    workspace = lib.mkOption {
      type = lib.types.str; default = "/home/${cfg.user}";
      description = "The only directory tree in which the agent may delete.";
    };
    protectedBranch = lib.mkOption {
      type = lib.types.str; default = "main";
      description = "Branch the agent may never push to directly.";
    };
    protectedPaths = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ "/etc" "/var" "/usr" "/boot" "/root" "/srv" "/opt" "/sys" "/proc" "/dev" "/nix" ];
      description = "Paths a delete may never reach.";
    };
    writablePaths = lib.mkOption {
      type = lib.types.listOf lib.types.str; default = [ ];
      description = "Shared ground the agent MAY delete within, despite protectedPaths.";
    };
    deniedApplyCommands = lib.mkOption {
      type = lib.types.listOf lib.types.str; default = [ ];
      example = [ "nixos-rebuild" "ansible-playbook" ];
      description = ''
        Commands that APPLY config to a live system. Denied outright — applying
        is a post-merge action, and an agent that can apply its own proposals
        has no gate at all.
      '';
    };
    extraDeny = lib.mkOption {
      type = lib.types.listOf lib.types.str; default = [ ];
      description = "Extra Claude Code deny rules appended to the managed list.";
    };
    etcDir = lib.mkOption {
      type = lib.types.str; default = "/etc/claude-code"; internal = true;
    };

    reflection = {
      enable = lib.mkOption { type = lib.types.bool; default = true; };
      sessionInterval = lib.mkOption { type = lib.types.int; default = 8; };
      openItemCap = lib.mkOption { type = lib.types.int; default = 4; };
    };
    clock.enable = lib.mkOption { type = lib.types.bool; default = true; };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = cfg.user != "root";
        message = "services.claudeAgent.user must not be root — the OS boundary is the load-bearing layer.";
      }
      {
        assertion = !(lib.elem "wheel" (config.users.users.${cfg.user}.extraGroups or [ ]));
        message = ''
          services.claudeAgent.user is in `wheel`. Privilege must come from an explicit,
          reviewed sudo allowlist, never from group membership — otherwise the sudo
          allowlist is not the boundary it appears to be.
        '';
      }
    ];

    # Root-owned, agent-unwritable. This placement is the whole point: an agent
    # that can edit its own backstop has no backstop.
    environment.etc."claude-code/managed-settings.json" = {
      text = builtins.toJSON managedSettings;
      mode = "0444";
    };
    environment.etc."claude-code/pretooluse-guard.sh" = { source = guardScript; mode = "0555"; };
    environment.etc."claude-code/reflection-hook.sh" =
      lib.mkIf cfg.reflection.enable { source = reflectionHook; mode = "0555"; };
    environment.etc."claude-code/clock-hook.sh" =
      lib.mkIf cfg.clock.enable { source = clockHook; mode = "0555"; };

    # Kept next to what they test, so a live host can be checked in place.
    environment.etc."claude-code/guard-cases.tsv" = { source = ../tests/guard-cases.tsv; mode = "0444"; };
    environment.etc."claude-code/guard-test.sh"   = { source = ../tests/guard-test.sh;   mode = "0555"; };
  };
}
